{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 第1节：数字图像基础 - 动手实验\n",
    "\n",
    "本notebook包含第1节课的所有实验代码，请按顺序执行每个单元。"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. 导入必要的库"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import cv2\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import os\n",
    "\n",
    "print(\"✅ 所有库导入成功！\")\n",
    "print(f\"OpenCV版本: {cv2.__version__}\")\n",
    "print(f\"NumPy版本: {np.__version__}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. 生成测试图像\n",
    "\n",
    "创建一个720p（1280×720）的四色测试图像：\n",
    "- 左上：红色\n",
    "- 右上：绿色\n",
    "- 左下：蓝色\n",
    "- 右下：白色"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def generate_test_image(width=1280, height=720):\n",
    "    \"\"\"\n",
    "    生成一个四色测试图像\n",
    "    - 左上：红色\n",
    "    - 右上：绿色\n",
    "    - 左下：蓝色\n",
    "    - 右下：白色\n",
    "    \"\"\"\n",
    "    img = np.zeros((height, width, 3), dtype=np.uint8)\n",
    "    \n",
    "    # 左上：红色 (BGR格式)\n",
    "    img[0:height//2, 0:width//2] = [0, 0, 255]\n",
    "    \n",
    "    # 右上：绿色\n",
    "    img[0:height//2, width//2:width] = [0, 255, 0]\n",
    "    \n",
    "    # 左下：蓝色\n",
    "    img[height//2:height, 0:width//2] = [255, 0, 0]\n",
    "    \n",
    "    # 右下：白色\n",
    "    img[height//2:height, width//2:width] = [255, 255, 255]\n",
    "    \n",
    "    return img\n",
    "\n",
    "# 生成测试图像\n",
    "img = generate_test_image()\n",
    "\n",
    "print(f\"✅ 测试图像生成成功！\")\n",
    "print(f\"图像尺寸: {img.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. 显示原始图像"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 转换为RGB格式供matplotlib显示\n",
    "img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n",
    "\n",
    "# 显示图像\n",
    "plt.figure(figsize=(12, 7))\n",
    "plt.imshow(img_rgb)\n",
    "plt.title(\"Test Image (1280x720)\", fontsize=16)\n",
    "plt.axis('off')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. 探索图像属性"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"=== 图像属性 ===\")\n",
    "print(f\"图像形状: {img.shape}\")\n",
    "print(f\"  - 高度: {img.shape[0]} 像素\")\n",
    "print(f\"  - 宽度: {img.shape[1]} 像素\")\n",
    "print(f\"  - 通道数: {img.shape[2]}\")\n",
    "print(f\"\\n数据类型: {img.dtype}\")\n",
    "print(f\"每个像素大小: {img.itemsize} 字节\")\n",
    "print(f\"\\n总元素数: {img.size:,}\")\n",
    "print(f\"总字节数: {img.nbytes:,}\")\n",
    "print(f\"\\n总像素数: {img.shape[0] * img.shape[1]:,}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. 访问单个像素"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 访问不同位置的像素\n",
    "positions = [(100, 100), (360, 640), (600, 1000)]\n",
    "\n",
    "print(\"=== 像素值访问 ===\")\n",
    "for row, col in positions:\n",
    "    pixel_bgr = img[row, col]\n",
    "    print(f\"\\n位置({row}, {col})的像素值(BGR): {pixel_bgr}\")\n",
    "    print(f\"  - B(蓝色): {pixel_bgr[0]}\")\n",
    "    print(f\"  - G(绿色): {pixel_bgr[1]}\")\n",
    "    print(f\"  - R(红色): {pixel_bgr[2]}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. 修改单个像素"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 创建副本用于修改\n",
    "img_modified = img.copy()\n",
    "\n",
    "# 修改位置(100, 100)的像素为青色\n",
    "row, col = 100, 100\n",
    "old_pixel = img_modified[row, col].copy()\n",
    "img_modified[row, col] = [255, 255, 0]  # 青色（BGR）\n",
    "new_pixel = img_modified[row, col]\n",
    "\n",
    "print(f\"=== 像素修改 ===\")\n",
    "print(f\"位置({row}, {col})\")\n",
    "print(f\"修改前: {old_pixel}\")\n",
    "print(f"修改后: {new_pixel}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. 区域颜色修改"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 创建副本用于区域修改\n",
    "img_region = img.copy()\n",
    "\n",
    "# 将左上角200x200区域改为黄色\n",
    "region_size = 200\n",
    "img_region[0:region_size, 0:region_size] = [0, 255, 255]  # 黄色（BGR）\n",
    "\n",
    "# 将右下角300x300区域改为紫色\n",
    "img_region[-300:, -300:] = [255, 0, 255]  # 紫色（BGR）\n",
    "\n",
    "# 在中心添加一个100x100的橙色方块\n",
    "center_y, center_x = 360, 640\n",
    "half_size = 50\n",
    "img_region[center_y-half_size:center_y+half_size, \n",
    "          center_x-half_size:center_x+half_size] = [0, 165, 255]  # 橙色（BGR）\n",
    "\n",
    "print(\"✅ 区域修改完成！\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. 对比显示原始图像和修改后的图像"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 7))\n",
    "\n",
    "# 原始图像\n",
    "ax1.imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))\n",
    "ax1.set_title(\"Original Image\", fontsize=14)\n",
    "ax1.axis('off')\n",
    "\n",
    "# 修改后的图像\n",
    "ax2.imshow(cv2.cvtColor(img_region, cv2.COLOR_BGR2RGB))\n",
    "ax2.set_title(\"Modified Image (Regions)\", fontsize=14)\n",
    "ax2.axis('off')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. RGB通道分离"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 分离RGB通道\n",
    "b_channel = img[:, :, 0]  # 蓝色通道\n",
    "g_channel = img[:, :, 1]  # 绿色通道\n",
    "r_channel = img[:, :, 2]  # 红色通道\n",
    "\n",
    "print(\"=== 通道信息 ===\")\n",
    "print(f\"蓝色通道形状: {b_channel.shape}\")\n",
    "print(f\"绿色通道形状: {g_channel.shape}\")\n",
    "print(f\"红色通道形状: {r_channel.shape}\")\n",
    "print(f\"\\n通道数据类型: {b_channel.dtype}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10. 可视化RGB通道"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(2, 2, figsize=(12, 12))\n",
    "\n",
    "# 原始图像\n",
    "axes[0, 0].imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))\n",
    "axes[0, 0].set_title(\"Original Image\", fontsize=14)\n",
    "axes[0, 0].axis('off')\n",
    "\n",
    "# 红色通道（用红色调色板显示）\n",
    "axes[0, 1].imshow(r_channel, cmap='Reds')\n",
    "axes[0, 1].set_title(\"Red Channel\", fontsize=14)\n",
    "axes[0, 1].axis('off')\n",
    "\n",
    "# 绿色通道\n",
    "axes[1, 0].imshow(g_channel, cmap='Greens')\n",
    "axes[1, 0].set_title(\"Green Channel\", fontsize=14)\n",
    "axes[1, 0].axis('off')\n",
    "\n",
    "# 蓝色通道\n",
    "axes[1, 1].imshow(b_channel, cmap='Blues')\n",
    "axes[1, 1].set_title(\"Blue Channel\", fontsize=14)\n",
    "axes[1, 1].axis('off')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 11. 保存修改后的图像"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 确保输出目录存在\n",
    "output_dir = '../output'\n",
    "os.makedirs(output_dir, exist_ok=True)\n",
    "\n",
    "# 保存图像\n",
    "output_path = os.path.join(output_dir, 'modified_image.jpg')\n",
    "success = cv2.imwrite(output_path, img_region)\n",
    "\n",
    "if success:\n",
    "    print(f\"✅ 图像已成功保存到: {output_path}\")\n",
    "    \n",
    "    # 读取并验证\n",
    "    saved_img = cv2.imread(output_path)\n",
    "    print(f\"✅ 保存的图像尺寸: {saved_img.shape}\")\n",
    "    print(f\"✅ 文件大小: {os.path.getsize(output_path):,} 字节\")\n",
    "else:\n",
    "    print(f\"❌ 图像保存失败\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🎯 课后挑战：尝试以下任务\n",
    "\n",
    "### 挑战1：创建渐变图像\n",
    "```python\n",
    "# 创建一个从左到右的红色渐变图像\n",
    "gradient = np.zeros((720, 1280, 3), dtype=np.uint8)\n",
    "for x in range(1280):\n",
    "    intensity = int((x / 1280) * 255)\n",
    "    gradient[:, x] = [0, 0, intensity]  # BGR\n",
    "\n",
    "plt.figure(figsize=(12, 7))\n",
    "plt.imshow(cv2.cvtColor(gradient, cv2.COLOR_BGR2RGB))\n",
    "plt.title(\"Red Gradient\")\n",
    "plt.axis('off')\n",
    "plt.show()\n",
    "```\n",
    "\n",
    "### 挑战2：计算图像平均亮度\n",
    "```python\n",
    "mean_brightness = np.mean(img)\n",
    "print(f\"平均亮度: {mean_brightness:.2f}\")\n",
    "```\n",
    "\n",
    "### 挑战3：实现图像水平翻转\n",
    "```python\n",
    "flipped = img[:, ::-1]  # 水平翻转\n",
    "\n",
    "plt.figure(figsize=(12, 7))\n",
    "plt.imshow(cv2.cvtColor(flipped, cv2.COLOR_BGR2RGB))\n",
    "plt.title(\"Horizontally Flipped\")\n",
    "plt.axis('off')\n",
    "plt.show()\n",
    "```\n",
    "\n",
    "### 挑战4：创建棋盘格图像\n",
    "```python\n",
    "chessboard = np.zeros((720, 1280, 3), dtype=np.uint8)\n",
    "cell_size = 100\n",
    "\n",
    "for y in range(0, 720, cell_size):\n",
    "    for x in range(0, 1280, cell_size):\n",
    "        if ((y // cell_size) + (x // cell_size)) % 2 == 0:\n",
    "            chessboard[y:y+cell_size, x:x+cell_size] = [255, 255, 255]\n",
    "\n",
    "plt.figure(figsize=(12, 7))\n",
    "plt.imshow(chessboard)\n",
    "plt.title(\"Chessboard Pattern\")\n",
    "plt.axis('off')\n",
    "plt.show()\n",
    "```"
   ]
  },
